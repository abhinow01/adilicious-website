# Copy to .env.local (development) or .env.production.local (VPS) and fill in.
# Never commit the real file. Variables without NEXT_PUBLIC_ never reach the browser.

# Sanity project (manage.sanity.io → your project). Public identifiers, but server-only here.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Viewer token: lets the server read drafts for the preview. Server-only secret.
# manage.sanity.io → API → Tokens → Add token → permission "Viewer"
SANITY_API_READ_TOKEN=

# Secret shared with the Sanity webhook that refreshes the site after a publish. Server-only.
# Generate with:  openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# The site's public address, without a trailing slash. Used for canonical URLs, sitemap,
# social cards and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to 1 on a staging copy to keep it out of search engines.
# SITE_NOINDEX=1
