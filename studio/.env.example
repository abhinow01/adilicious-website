# Copy to .env and fill in. These values are public identifiers, not secrets.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# The website origin used by the Presentation (preview) tool
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
# Optional: the hostname for `npm run deploy` -> https://<host>.sanity.studio
SANITY_STUDIO_HOSTNAME=adilicious

# Only for `npm run seed` (never commit, never put in the website):
# a token with Editor permissions from manage.sanity.io -> API -> Tokens
SANITY_WRITE_TOKEN=
